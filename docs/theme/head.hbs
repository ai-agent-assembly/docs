<!-- Google Analytics 4 (gtag.js) + Consent Mode v2 — docs hub.
     The Measurement ID is public (embedded client-side), not a secret.
     Analytics storage is denied by default and only enabled after explicit
     opt-in. AAASM-3552 / AAASM-3554. -->
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  // Consent Mode v2 — deny analytics/ads storage until the visitor opts in.
  gtag('consent', 'default', {
    'analytics_storage': 'denied',
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied'
  });
  // Re-apply a stored opt-in before the first hit fires.
  try {
    if (window.localStorage && localStorage.getItem('aa-analytics-consent') === 'granted') {
      gtag('consent', 'update', { 'analytics_storage': 'granted' });
    }
  } catch (e) {}
  gtag('js', new Date());
  gtag('config', 'G-EZTLJDFS6J', { 'anonymize_ip': true });
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-EZTLJDFS6J"></script>

<!-- Opt-in cookie-consent banner (vanilla JS, no external request) — AAASM-3554. -->
<style>
  .aa-consent { position: fixed; left: 1rem; right: 1rem; bottom: 1rem; z-index: 2147483647;
    max-width: 42rem; margin: 0 auto; padding: 1rem 1.25rem; border-radius: 8px;
    background: #1f2430; color: #e7eaf0; box-shadow: 0 4px 24px rgba(0, 0, 0, .35);
    font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .aa-consent p { margin: 0 0 .75rem; }
  .aa-consent a { color: #8ab4f8; }
  .aa-consent__actions { display: flex; gap: .5rem; flex-wrap: wrap; }
  .aa-consent button { cursor: pointer; border: 0; border-radius: 6px; padding: .45rem .9rem;
    font-size: 14px; font-weight: 600; }
  .aa-consent__accept { background: #8ab4f8; color: #14161b; }
  .aa-consent__reject { background: transparent; color: #e7eaf0; border: 1px solid #4a5160; }
</style>
<script>
  (function () {
    var KEY = 'aa-analytics-consent';
    function stored() {
      try { return window.localStorage && localStorage.getItem(KEY); } catch (e) { return null; }
    }
    if (stored()) { return; } // visitor already chose — no banner
    function choose(value) {
      try { localStorage.setItem(KEY, value); } catch (e) {}
      if (value === 'granted' && typeof gtag === 'function') {
        gtag('consent', 'update', { 'analytics_storage': 'granted' });
      }
      var box = document.querySelector('.aa-consent');
      if (box && box.parentNode) { box.parentNode.removeChild(box); }
    }
    function build() {
      if (stored() || document.querySelector('.aa-consent')) { return; }
      var box = document.createElement('div');
      box.className = 'aa-consent';
      box.setAttribute('role', 'dialog');
      box.setAttribute('aria-live', 'polite');
      box.setAttribute('aria-label', 'Cookie consent');
      var text = document.createElement('p');
      text.textContent = 'We use Google Analytics to understand documentation usage. '
        + 'Analytics cookies are only set if you accept.';
      var actions = document.createElement('div');
      actions.className = 'aa-consent__actions';
      var accept = document.createElement('button');
      accept.type = 'button';
      accept.className = 'aa-consent__accept';
      accept.textContent = 'Accept';
      accept.addEventListener('click', function () { choose('granted'); });
      var reject = document.createElement('button');
      reject.type = 'button';
      reject.className = 'aa-consent__reject';
      reject.textContent = 'Reject';
      reject.addEventListener('click', function () { choose('denied'); });
      actions.appendChild(accept);
      actions.appendChild(reject);
      box.appendChild(text);
      box.appendChild(actions);
      document.body.appendChild(box);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', build);
    } else {
      build();
    }
  })();
</script>

<!-- "Was this page helpful?" feedback widget (vanilla JS) — AAASM-3555. -->
<style>
  .aa-feedback { margin: 3rem 0 1rem; padding-top: 1.25rem; border-top: 1px solid rgba(127, 127, 127, .25);
    font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .aa-feedback__q { font-weight: 600; margin: 0 0 .5rem; }
  .aa-feedback__actions { display: flex; gap: .5rem; align-items: center; }
  .aa-feedback__btn { cursor: pointer; border: 1px solid rgba(127, 127, 127, .4); background: transparent;
    color: inherit; border-radius: 6px; padding: .35rem .75rem; font-size: 14px; line-height: 1; }
  .aa-feedback__btn:hover { border-color: #8ab4f8; }
  .aa-feedback__msg { margin: .5rem 0 0; }
  .aa-feedback__msg a { color: #8ab4f8; }
</style>
<script>
  (function () {
    // Per-site repo for the "tell us what to improve" pre-filled issue link.
    var REPO = 'docs';
    function sendFeedback(value) {
      // Consent Mode (AAASM-3554) governs whether this hit is stored; fire either way.
      if (typeof gtag === 'function') {
        gtag('event', 'feedback', { 'value': value, 'page_path': location.pathname });
      }
    }
    function issueUrl() {
      var title = 'Docs feedback: ' + location.pathname;
      var body = 'Page: ' + location.href + '\n\nWhat could be improved?\n';
      return 'https://github.com/ai-agent-assembly/' + REPO + '/issues/new?labels=docs,feedback'
        + '&title=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(body);
    }
    function build() {
      var main = document.querySelector('main');
      if (!main || document.querySelector('.aa-feedback')) { return; }
      var box = document.createElement('div');
      box.className = 'aa-feedback';
      var q = document.createElement('p');
      q.className = 'aa-feedback__q';
      q.textContent = 'Was this page helpful?';
      var actions = document.createElement('div');
      actions.className = 'aa-feedback__actions';
      var msg = document.createElement('p');
      msg.className = 'aa-feedback__msg';
      function done(text, withLink) {
        if (actions.parentNode) { actions.parentNode.removeChild(actions); }
        msg.textContent = text;
        if (withLink) {
          msg.appendChild(document.createTextNode(' '));
          var a = document.createElement('a');
          a.href = issueUrl();
          a.target = '_blank';
          a.rel = 'noopener';
          a.textContent = 'Tell us what we can improve →';
          msg.appendChild(a);
        }
      }
      var yes = document.createElement('button');
      yes.type = 'button';
      yes.className = 'aa-feedback__btn';
      yes.textContent = '👍 Yes';
      yes.addEventListener('click', function () { sendFeedback(1); done('Thanks for your feedback!', false); });
      var no = document.createElement('button');
      no.type = 'button';
      no.className = 'aa-feedback__btn';
      no.textContent = '👎 No';
      no.addEventListener('click', function () { sendFeedback(0); done('Thanks — sorry this page missed the mark.', true); });
      actions.appendChild(yes);
      actions.appendChild(no);
      box.appendChild(q);
      box.appendChild(actions);
      box.appendChild(msg);
      main.appendChild(box);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', build);
    } else {
      build();
    }
  })();
</script>

<!-- Unified search across the hub + all module docs (AAASM-3664).
     Pagefind indexes the FINAL aggregated public/ at build time (see
     docs/scripts/aggregate.sh), so this one box searches the hub, core,
     python-sdk, node-sdk and go-sdk together. Assets live at {{ path_to_root }}pagefind/ (base-path-aware via mdBook
     path_to_root, so it works under a project subpath like
     github.io/docs/ AND at the root docs.agent-assembly.com).
     When the hub is
     built standalone (no aggregation), /pagefind/ is absent and the widget
     silently no-ops — the mdBook native search still works. -->
<link href="{{ path_to_root }}pagefind/pagefind-ui.css" rel="stylesheet" onerror="this.dataset.failed=1">
<script src="{{ path_to_root }}pagefind/pagefind-ui.js" onerror="window.__aaPagefindMissing=1"></script>
<style>
  .aa-search { margin: 0 0 1rem; }
  .aa-search__open { cursor: pointer; width: 100%; text-align: left; border: 1px solid rgba(127,127,127,.4);
    background: transparent; color: inherit; border-radius: 8px; padding: .5rem .85rem; font-size: 14px; }
  .aa-search__open:hover { border-color: #8ab4f8; }
  .aa-search__modal { position: fixed; inset: 0; z-index: 2147483646; display: none;
    background: rgba(0,0,0,.45); }
  .aa-search__modal.is-open { display: block; }
  .aa-search__panel { max-width: 44rem; margin: 6vh auto 0; background: var(--bg, #fff); color: inherit;
    border-radius: 10px; padding: 1rem; box-shadow: 0 10px 40px rgba(0,0,0,.4); }
  html[data-theme="navy"] .aa-search__panel,
  html[data-theme="coal"] .aa-search__panel,
  html[data-theme="ayu"] .aa-search__panel { background: #1f2430; }
  .aa-search__hint { font-size: 12px; opacity: .7; margin: .5rem 0 0; }
</style>
<script>
  (function () {
    function init() {
      if (window.__aaPagefindMissing || typeof PagefindUI === 'undefined') { return; }
      // Inject a search trigger at the top of the mdBook content area.
      var content = document.querySelector('#content main') || document.querySelector('main');
      if (!content || document.querySelector('.aa-search')) { return; }
      var wrap = document.createElement('div');
      wrap.className = 'aa-search';
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'aa-search__open';
      btn.textContent = '🔎  Search all docs (hub · core · python · node · go) …';
      var modal = document.createElement('div');
      modal.className = 'aa-search__modal';
      var panel = document.createElement('div');
      panel.className = 'aa-search__panel';
      var box = document.createElement('div');
      box.id = 'aa-pagefind-search';
      var hint = document.createElement('p');
      hint.className = 'aa-search__hint';
      hint.textContent = 'Searches the hub and every module. Press Esc to close.';
      panel.appendChild(box); panel.appendChild(hint); modal.appendChild(panel);
      wrap.appendChild(btn);
      content.insertBefore(wrap, content.firstChild);
      document.body.appendChild(modal);

      var built = false;
      function open() {
        if (!built) {
          // Derive an ABSOLUTE bundlePath from the loaded UI script URL: PagefindUI
          // import()s `${bundlePath}pagefind.js`, and a relative/bare path fails to
          // resolve as a module specifier. The resolved script .src is absolute and
          // correct under both the github.io project subpath and the root domain.
          var __pfs = document.querySelector('script[src$="pagefind/pagefind-ui.js"]');
          var __pfBase = __pfs ? __pfs.src.replace(/pagefind-ui\.js(\?.*)?$/, '') : new URL('{{ path_to_root }}pagefind/', location.href).href;
          new PagefindUI({ element: '#aa-pagefind-search', bundlePath: __pfBase, showSubResults: true, showImages: false });
          built = true;
        }
        modal.classList.add('is-open');
        var input = panel.querySelector('input');
        if (input) { input.focus(); }
      }
      function close() { modal.classList.remove('is-open'); }
      btn.addEventListener('click', open);
      modal.addEventListener('click', function (e) { if (e.target === modal) { close(); } });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { close(); } });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else { init(); }
  })();
</script>

<!-- Hub-level module + version switcher (AAASM-3758).
     A persistent header on every hub page that lets you jump straight to any
     aggregated module at any version/channel WITHOUT first opening that module.
     It is driven entirely by the manifests the aggregation already produces —
     {{ path_to_root }}modules.json (module list + subpaths, copied verbatim by
     docs/scripts/aggregate.sh) and each {{ path_to_root }}<subpath>/versions.json
     (the same manifest each module's own per-version switcher reads). There are
     NO hard-coded module or version strings here. Selecting a module + version
     navigates to /<subpath>/<channel-or-tag>/. A module whose versions.json is
     absent (e.g. node-sdk / go-sdk, or a hub built standalone with no
     aggregation) degrades gracefully: it is still listed and its option links to
     the module root. If modules.json itself is absent the widget silently
     no-ops, exactly like the Pagefind search above. base-path-aware via mdBook's
     {{ path_to_root }} so it works under the github.io project subpath AND at the
     root docs.agent-assembly.com. -->
<style>
  .aa-modswitch { margin: 0 0 1rem; padding: .6rem .85rem; border: 1px solid rgba(127,127,127,.4);
    border-radius: 8px; display: flex; flex-wrap: wrap; gap: .5rem; align-items: center;
    font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .aa-modswitch__label { font-weight: 600; margin-right: .15rem; }
  .aa-modswitch select { cursor: pointer; border: 1px solid rgba(127,127,127,.4); background: transparent;
    color: inherit; border-radius: 6px; padding: .35rem .5rem; font-size: 14px; max-width: 18rem; }
  html[data-theme="navy"] .aa-modswitch select option,
  html[data-theme="coal"] .aa-modswitch select option,
  html[data-theme="ayu"] .aa-modswitch select option { background: #1f2430; color: #e7eaf0; }
  .aa-modswitch__go { cursor: pointer; border: 0; border-radius: 6px; padding: .4rem .85rem;
    font-size: 14px; font-weight: 600; background: #8ab4f8; color: #14161b; text-decoration: none; }
  .aa-modswitch__go:hover { filter: brightness(1.05); }
</style>
<script>
  (function () {
    // base-path-aware root (works under github.io/docs/ AND the root domain).
    var ROOT = '{{ path_to_root }}';

    function el(tag, attrs) {
      var n = document.createElement(tag);
      for (var k in attrs) { if (attrs.hasOwnProperty(k)) { n.setAttribute(k, attrs[k]); } }
      return n;
    }
    function option(value, label) {
      var o = document.createElement('option');
      o.value = value; o.textContent = label;
      return o;
    }
    function prettyModule(name) {
      // Display-only label; never affects navigation (which uses subpath).
      return name.replace(/-/g, ' ').replace(/\bsdk\b/gi, 'SDK')
                 .replace(/^\w/, function (c) { return c.toUpperCase(); });
    }
    // Normalise either manifest shape into a flat [{value, label}] option list.
    //   core (mdBook)  -> { channels:[{id,title}], archived:[{id,title}] }
    //   python (mike)  -> [ {version,title,aliases:[...]} ]
    // value is the subpath segment to navigate to (/<module>/<value>/).
    function optionsFromManifest(data) {
      var opts = [];
      if (Array.isArray(data)) {
        data.forEach(function (e) {
          if (!e || !e.version) { return; }
          var label = e.title || e.version;
          if (e.aliases && e.aliases.length) { label += ' — ' + e.aliases.join(' / '); }
          opts.push({ value: e.version, label: label });
        });
      } else if (data && typeof data === 'object') {
        (data.channels || []).forEach(function (c) {
          if (c && c.id) { opts.push({ value: c.id, label: c.title || c.id }); }
        });
        (data.archived || []).forEach(function (a) {
          if (a && a.id) { opts.push({ value: a.id, label: a.title || a.id }); }
        });
      }
      return opts;
    }

    function build(modules) {
      var content = document.querySelector('#content main') || document.querySelector('main');
      if (!content || !modules.length || document.querySelector('.aa-modswitch')) { return; }

      var bar = el('div', { 'class': 'aa-modswitch', 'role': 'group', 'aria-label': 'Browse module documentation' });
      var label = el('span', { 'class': 'aa-modswitch__label' });
      label.textContent = 'Browse module docs:';
      var modSel = el('select', { 'class': 'aa-modswitch__mod', 'aria-label': 'Module' });
      var verSel = el('select', { 'class': 'aa-modswitch__ver', 'aria-label': 'Version or channel' });
      var go = el('a', { 'class': 'aa-modswitch__go', 'href': '#' });
      go.textContent = 'Go →';

      modules.forEach(function (m) {
        if (m && m.name && m.subpath) { modSel.appendChild(option(m.subpath, prettyModule(m.name))); }
      });

      function targetUrl() {
        var sub = modSel.value;
        var ver = verSel.value;
        return ROOT + sub + '/' + (ver ? ver + '/' : '');
      }
      function loadVersions() {
        var sub = modSel.value;
        verSel.innerHTML = '';
        verSel.disabled = true;
        verSel.appendChild(option('', 'Loading…'));
        fetch(ROOT + sub + '/versions.json', { cache: 'no-cache' })
          .then(function (r) { if (!r.ok) { throw new Error('no manifest'); } return r.json(); })
          .then(function (data) {
            var opts = optionsFromManifest(data);
            verSel.innerHTML = '';
            if (!opts.length) { throw new Error('empty manifest'); }
            opts.forEach(function (o) { verSel.appendChild(option(o.value, o.label)); });
            verSel.disabled = false;
          })
          .catch(function () {
            // No (or unreadable) versions.json — still navigable; fall back to the module root.
            verSel.innerHTML = '';
            verSel.appendChild(option('', 'latest'));
            verSel.disabled = false;
          });
      }

      modSel.addEventListener('change', loadVersions);
      go.addEventListener('click', function (e) { e.preventDefault(); location.href = targetUrl(); });
      verSel.addEventListener('keydown', function (e) { if (e.key === 'Enter') { location.href = targetUrl(); } });

      bar.appendChild(label);
      bar.appendChild(modSel);
      bar.appendChild(verSel);
      bar.appendChild(go);
      content.insertBefore(bar, content.firstChild);
      loadVersions();
    }

    function init() {
      if (document.querySelector('.aa-modswitch')) { return; }
      fetch(ROOT + 'modules.json', { cache: 'no-cache' })
        .then(function (r) { if (!r.ok) { throw new Error('no modules.json'); } return r.json(); })
        .then(function (data) { build((data && data.modules) || []); })
        .catch(function () { /* standalone hub build (no aggregation) — silently no-op */ });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else { init(); }
  })();
</script>

<!-- Language switcher + zh-Hant draft banner (AAASM-4697).
     Localization is produced by the mdbook-i18n-helpers gettext workflow (see
     docs/book.toml): the aggregation pipeline (docs/scripts/aggregate.sh)
     builds English at the site root and the zh-Hant catalog under /zh-Hant/.
     mdBook injects the CURRENT language here via {{ language }} ('en' at root,
     'zh-Hant' under /zh-Hant/) and the book-relative root via {{ path_to_root }},
     so the switcher maps the current page to its counterpart in the other
     language WITHOUT any hard-coded page list: English page  <ROOT>/<page>  <->
     zh-Hant page  <ROOT>/zh-Hant/<page>. Both languages ship every page (the
     gettext build falls back to English for untranslated strings), so the
     counterpart URL always exists on the deployed hub. When the hub is built
     standalone as English-only (no /zh-Hant/ tree), the switcher still renders;
     its 繁體中文 link simply points where the aggregated build would place it. -->
<style>
  .aa-langswitch { display: inline-flex; gap: .35rem; align-items: center; margin-left: .35rem;
    font: 13px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .aa-langswitch a { color: inherit; text-decoration: none; padding: .25rem .5rem; border-radius: 6px;
    border: 1px solid transparent; opacity: .8; }
  .aa-langswitch a:hover { border-color: rgba(127,127,127,.4); opacity: 1; }
  .aa-langswitch a[aria-current="true"] { font-weight: 700; opacity: 1; border-color: rgba(127,127,127,.4); }
  .aa-draft-banner { margin: 0 0 1rem; padding: .6rem .85rem; border-radius: 8px;
    border: 1px solid #d9a441; background: rgba(217,164,65,.12); color: inherit;
    font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .aa-draft-banner strong { font-weight: 700; }
</style>
<script>
  (function () {
    var LANG = '{{ language }}';           // 'en' at the site root, 'zh-Hant' under /zh-Hant/
    var ROOT = '{{ path_to_root }}';       // book-relative root of the CURRENT language build
    // Pages that have an actual zh-Hant first-pass translation (everything else
    // renders as English fallback, so no draft banner for those).
    var TRANSLATED = { 'index.html': 1, 'faq.html': 1, 'glossary.html': 1, 'quickstart-saas.html': 1 };

    function urls() {
      var bookRoot = new URL(ROOT || './', location.href);       // absolute root of this book
      var pageRel = location.pathname;
      if (pageRel.indexOf(bookRoot.pathname) === 0) { pageRel = pageRel.slice(bookRoot.pathname.length); }
      var siteRoot = (LANG === 'zh-Hant') ? new URL('../', bookRoot) : bookRoot;
      var base = pageRel.split('/').pop() || 'index.html';
      return {
        base: base,
        en: new URL(pageRel, siteRoot).href,
        zh: new URL('zh-Hant/' + pageRel, siteRoot).href
      };
    }

    function switcher() {
      var bar = document.querySelector('.menu-bar .right-buttons') || document.querySelector('.menu-bar');
      if (!bar || document.querySelector('.aa-langswitch')) { return; }
      var u = urls();
      var wrap = document.createElement('div');
      wrap.className = 'aa-langswitch';
      wrap.setAttribute('role', 'group');
      wrap.setAttribute('aria-label', 'Language / 語言');
      function link(href, label, current) {
        var a = document.createElement('a');
        a.href = href; a.textContent = label; a.setAttribute('lang', label === 'English' ? 'en' : 'zh-Hant');
        if (current) { a.setAttribute('aria-current', 'true'); }
        return a;
      }
      wrap.appendChild(link(u.en, 'English', LANG !== 'zh-Hant'));
      wrap.appendChild(link(u.zh, '繁體中文', LANG === 'zh-Hant'));
      bar.appendChild(wrap);
    }

    function draftBanner() {
      if (LANG !== 'zh-Hant') { return; }
      var u = urls();
      if (!TRANSLATED[u.base]) { return; }
      var content = document.querySelector('#content main') || document.querySelector('main');
      if (!content || document.querySelector('.aa-draft-banner')) { return; }
      var box = document.createElement('div');
      box.className = 'aa-draft-banner';
      box.setAttribute('role', 'note');
      box.setAttribute('lang', 'zh-Hant');
      var s = document.createElement('strong');
      s.textContent = '本頁為機器初翻，尚待母語審閱';
      box.appendChild(s);
      box.appendChild(document.createTextNode(' (draft — machine first-pass, pending native review)'));
      content.insertBefore(box, content.firstChild);
    }

    function init() { switcher(); draftBanner(); }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else { init(); }
  })();
</script>

<!-- Component-mount block in the sidebar (AAASM-5608, closing AAASM-5591 GAP-7).
     AAASM-5594 measured that SUMMARY.md cannot carry this: an external URL entry
     aborts the build at exit 101 ("failed to write src/https://…"), a second entry
     for an already-listed page aborts at exit 101 ("Duplicate file in SUMMARY.md"),
     and the draft form `- [Python SDK]()` renders a <span> with no anchor. A
     theme-level block is therefore the only shape that puts the literal mount names
     in the sidebar, and it is the one option that costs no existing route — the
     documentation.md and README.md prefix chapters keep their two routes that sit
     outside every task section.

     Module names and subpaths are read from {{ path_to_root }}modules.json, the same
     manifest the module switcher above reads, so adding a component to
     hub-components.toml/modules.json surfaces it here with no navigation edit and
     there are NO hard-coded module strings. It reads only 'name' and 'subpath'; it
     does not read 'ref', so it is unaffected by AAASM-5728 (ref is inert for
     python-sdk and arena). If modules.json is absent — a hub built standalone with
     no aggregation — the block silently no-ops, exactly like the search and switcher
     widgets. Skipped inside the toc.html iframe fallback, which has its own copy of
     this head partial but no page chrome.

     TWO LIMITATIONS, RECORDED RATHER THAN LEFT TO BE DISCOVERED. This block is
     script-only, so with JavaScript disabled it does not render and GAP-7's sidebar
     half stays open for that reader — the mounts keep their one-hop prefix route via
     documentation.md and README.md, which pre-dates this change and is unaffected. And
     its strings ("Component documentation", and the breadcrumb's "Home" below) are
     built in JS rather than authored in Markdown, so mdbook-i18n-helpers never extracts
     them: they are outside the gettext catalog and stay English under /zh-Hant/ with no
     msgid to translate. Both belong in accessibility.md's Known limitations, which this
     ticket may not edit — its sitemap row bars it from touching any existing page body
     — so they are recorded here and handed on as a follow-up. -->
<style>
  .aa-mounts { margin: 1.25rem 0 .5rem; padding: .75rem .85rem 0; border-top: 1px solid rgba(127,127,127,.25); }
  .aa-mounts__title { font-size: 12px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .04em; opacity: .7; margin: 0 0 .5rem; }
  .aa-mounts ul { list-style: none; margin: 0; padding: 0; }
  .aa-mounts li { margin: 0 0 .15rem; }
  .aa-mounts a { display: block; padding: .25rem .35rem; border-radius: 6px;
    font-size: 14px; text-decoration: none; color: inherit; opacity: .85; }
  .aa-mounts a:hover { opacity: 1; background: rgba(127,127,127,.12); }
  .aa-mounts a:focus-visible { outline: 2px solid #8ab4f8; outline-offset: 1px; opacity: 1; }
</style>
<script>
  (function () {
    if (document.querySelector('.sidebar-iframe-inner')) { return; } // toc.html fallback
    var ROOT = '{{ path_to_root }}';

    function prettyModule(name) {
      // Display-only label; navigation always uses the manifest's subpath.
      return name.replace(/-/g, ' ').replace(/\bsdk\b/gi, 'SDK')
                 .replace(/^\w/, function (c) { return c.toUpperCase(); });
    }

    function build(modules) {
      var box = document.querySelector('.sidebar-scrollbox');
      if (!box || !modules.length || document.querySelector('.aa-mounts')) { return; }
      var wrap = document.createElement('div');
      wrap.className = 'aa-mounts';
      var h = document.createElement('p');
      h.className = 'aa-mounts__title';
      h.id = 'aa-mounts-title';
      h.textContent = 'Component documentation';
      var ul = document.createElement('ul');
      ul.setAttribute('aria-labelledby', 'aa-mounts-title');
      modules.forEach(function (m) {
        if (!m || !m.name || !m.subpath) { return; }
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = ROOT + m.subpath + '/';
        a.textContent = prettyModule(m.name);
        li.appendChild(a);
        ul.appendChild(li);
      });
      wrap.appendChild(h);
      wrap.appendChild(ul);
      box.appendChild(wrap);
    }

    function init() {
      fetch(ROOT + 'modules.json', { cache: 'no-cache' })
        .then(function (r) { if (!r.ok) { throw new Error('no modules.json'); } return r.json(); })
        .then(function (data) {
          var mods = (data && data.modules) || [];
          // The sidebar is populated by a custom element, so it may not exist yet.
          if (document.querySelector('.sidebar-scrollbox ol.chapter')) { build(mods); return; }
          var obs = new MutationObserver(function () {
            if (document.querySelector('.sidebar-scrollbox ol.chapter')) { obs.disconnect(); build(mods); }
          });
          obs.observe(document.documentElement, { childList: true, subtree: true });
          setTimeout(function () { obs.disconnect(); build(mods); }, 3000);
        })
        .catch(function () { /* standalone hub build (no aggregation) — silently no-op */ });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else { init(); }
  })();
</script>

<!-- Contextual breadcrumbs (AAASM-5608).
     AAASM-5594 recorded that mdBook renders no breadcrumb trail, so in mdBook this
     is a theme change or it does not happen; this is the theme change.

     The trail is DERIVED FROM THE SIDEBAR DOM rather than from a page->section map
     kept in this file: it locates the sidebar anchor whose resolved path matches the
     current page, then scans backwards for the nearest preceding `li.part-title`.
     That means SUMMARY.md stays the single source of the section structure and a
     re-filed page cannot desynchronise its breadcrumb from its sidebar position.
     Prefix chapters have no preceding part title and correctly get a two-level
     trail; the index gets none, because it is the crumb everything else points at.

     Rendered as nav > ol so assistive technology announces it as a list of links
     with the current page marked aria-current="page"; it wraps rather than scrolls
     at narrow widths. Skipped inside the toc.html iframe fallback. -->
<style>
  .aa-crumbs { margin: 0 0 1rem; font: 13px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .aa-crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: .15rem .1rem; }
  .aa-crumbs li { display: flex; align-items: center; }
  .aa-crumbs li + li::before { content: "/"; opacity: .45; margin: 0 .45rem; }
  .aa-crumbs a { color: inherit; opacity: .75; text-decoration: none; border-radius: 4px; padding: .1rem .2rem; }
  .aa-crumbs a:hover { opacity: 1; text-decoration: underline; }
  .aa-crumbs a:focus-visible { outline: 2px solid #8ab4f8; outline-offset: 1px; opacity: 1; }
  .aa-crumbs [aria-current="page"] { font-weight: 600; opacity: .95; }
</style>
<script>
  (function () {
    if (document.querySelector('.sidebar-iframe-inner')) { return; } // toc.html fallback
    var ROOT = '{{ path_to_root }}';

    function norm(p) { return p.replace(/index\.html$/, '').replace(/\/$/, ''); }

    function build() {
      if (document.querySelector('.aa-crumbs')) { return true; }
      var box = document.querySelector('.sidebar-scrollbox');
      var content = document.querySelector('#content main') || document.querySelector('main');
      if (!box || !content) { return false; }
      var nodes = box.querySelectorAll('li.part-title, ol.chapter a[href]');
      if (!nodes.length) { return false; }

      var here = norm(location.pathname);
      // The index is the root crumb; it does not carry a trail to itself.
      if (here === norm(new URL(ROOT || './', location.href).pathname)) { return true; }

      var idx = -1;
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        if (n.tagName !== 'A') { continue; }
        var href = n.getAttribute('href');
        // Skip protocol links, and skip the current page's own H2 entries, which
        // mdBook expands into the sidebar as bare '#fragment' anchors — they
        // resolve to this same path and would otherwise match as the chapter.
        if (!href || href.charAt(0) === '#' || /^[a-z]+:/i.test(href)) { continue; }
        if (norm(new URL(href, location.href).pathname) === here) { idx = i; break; }
      }
      if (idx === -1) { return true; } // page not in the sidebar — no trail to draw

      var section = null;
      for (var j = idx - 1; j >= 0; j--) {
        if (nodes[j].tagName !== 'A' && nodes[j].classList.contains('part-title')) {
          section = nodes[j].textContent.trim();
          break;
        }
      }

      var nav = document.createElement('nav');
      nav.className = 'aa-crumbs';
      nav.setAttribute('aria-label', 'Breadcrumb');
      var ol = document.createElement('ol');

      function crumb(text, href, current) {
        var li = document.createElement('li');
        if (href) {
          var a = document.createElement('a');
          a.href = href; a.textContent = text;
          li.appendChild(a);
        } else {
          var s = document.createElement('span');
          s.textContent = text;
          if (current) { s.setAttribute('aria-current', 'page'); }
          li.appendChild(s);
        }
        ol.appendChild(li);
      }

      // mdBook prefixes a chapter link with <strong aria-hidden="true">9.</strong>.
      // It is decorative and hidden from assistive technology in the sidebar, so
      // copying textContent would both read oddly and promote a hidden number into
      // announced breadcrumb content. Strip aria-hidden nodes before taking the text.
      function label(a) {
        var c = a.cloneNode(true);
        Array.prototype.forEach.call(
          c.querySelectorAll('[aria-hidden="true"]'),
          function (el) { el.parentNode.removeChild(el); }
        );
        return c.textContent.replace(/\s+/g, ' ').trim();
      }

      crumb('Home', ROOT || './', false);
      // A part title is plain text in mdBook, not a link, so the crumb is too.
      if (section) { crumb(section, null, false); }
      crumb(label(nodes[idx]), null, true);

      nav.appendChild(ol);
      // Anchor to the page's own <h1>, which is static markup, rather than to
      // content.firstChild: the search box, module switcher and language banner all
      // insert at firstChild from their own async callbacks, so competing for that
      // slot makes the breadcrumb's position depend on which fetch resolves first.
      // Sitting directly above the title is both deterministic and where a
      // breadcrumb belongs; those utility bars stay above it.
      var h1 = content.querySelector('h1');
      content.insertBefore(nav, h1 || content.firstChild);
      return true;
    }

    function init() {
      if (build()) { return; }
      var obs = new MutationObserver(function () { if (build()) { obs.disconnect(); } });
      obs.observe(document.documentElement, { childList: true, subtree: true });
      setTimeout(function () { obs.disconnect(); }, 3000);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else { init(); }
  })();
</script>
